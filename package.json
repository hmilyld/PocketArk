{
  "name": "pocketark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs dev && vite",
    "build": "node scripts/prepare.mjs build && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/lint-design.mjs && node scripts/lint-plugins.mjs && node scripts/check-docs.mjs",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "fmt:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "scaffold": "node scripts/scaffold.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "create-plugin": "node scripts/create-plugin.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "husky && node scripts/gen-commands.mjs",
    "lint:design": "node scripts/lint-design.mjs --strict"
  },
  "lint-staged": {
    "*.{ts,vue,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,vue,js,mjs,json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@lucide/vue": "^1.35.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "marked": "^18.0.11",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.1.10"
  }
}
